{
  "name": "deep-key-mirror",
  "version": "0.6.1",
  "description": "Alternative to React keyMirror",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "clean": "rm -rfv dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "docs": "typedoc --out docs --exclude '**/index.ts' src/ && touch docs/.nojekyll",
    "docs:publish": "pnpm docs && git push origin :gh-pages; git subtree push --prefix docs/ origin gh-pages",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkqubo/deep-key-mirror.git"
  },
  "keywords": [
    "React",
    "TypeScript",
    "JavaScript",
    "es6"
  ],
  "author": "tkqubo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tkqubo/deep-key-mirror/issues"
  },
  "homepage": "https://github.com/tkqubo/deep-key-mirror",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md",
    "tsconfig.json"
  ]
}
