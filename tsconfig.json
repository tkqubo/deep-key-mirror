{
  "compilerOptions": {
    // module resolution
    "target": "es2022",
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // transpile output
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // code quality
    "strict": true,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    // type-check only; the build artifacts are emitted by tsdown
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts", "tsdown.config.ts"]
}
